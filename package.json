{
  "name": "@kenz1117/dsh-engram",
  "description": "Local-first cross-session long-term memory for DeepSeek Harness: dual-scope SQLite stores, hybrid FTS5 + local-vector retrieval with RRF, an evidence gate, provenance audit and SM-2 spaced repetition. 23 narrow tools, zero external services, zero API keys.",
  "version": "0.11.0",
  "icon": "icon.svg",
  "logo": "icon-256.svg",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kenz1117/dsh-engram.git"
  },
  "homepage": "https://github.com/kenz1117/dsh-engram#readme",
  "bugs": {
    "url": "https://github.com/kenz1117/dsh-engram/issues"
  },
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./icon": "./icon.svg",
    "./icon.svg": "./icon.svg",
    "./logo.svg": "./icon-256.svg"
  },
  "files": [
    "lib/",
    "scripts/",
    "cordis.patch.yml",
    "icon.svg",
    "icon-256.svg",
    "CHANGELOG.md",
    "i18n/",
    "registry/",
    "docs/agent-language-guide.ru.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-locale"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "prepare": "node scripts/link-peers.mjs && node scripts/ensure-build.mjs",
    "bundle": "tsdown",
    "watch": "tsdown --watch",
    "test": "vitest run",
    "check:hooks": "node scripts/check-hook-order.mjs",
    "typecheck": "tsc --noEmit",
    "backfill": "node scripts/backfill-embeddings.mjs"
  },
  "license": "MIT",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "dsh",
    "dsh-market",
    "agi-architecture-exploration",
    "memory-palace",
    "method-of-loci",
    "memory",
    "long-term-memory",
    "agent-memory",
    "cross-session",
    "context-engineering",
    "local-first",
    "rag",
    "vector-search",
    "semantic-search",
    "knowledge-graph",
    "spaced-repetition",
    "provenance",
    "sqlite",
    "fts5",
    "embeddings",
    "knowledge-flywheel",
    "agent"
  ],
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/dsh-agent": "*",
    "@deepseek-ai/dsh-client-ui-layout": "*",
    "@deepseek-ai/dsh-llm": "*",
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-agent": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-layout": {
      "optional": true
    },
    "@deepseek-ai/dsh-llm": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dependencies": {
    "@huggingface/transformers": "^4.2.0"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "lightningcss": "^1.32.0",
    "tsdown": "^0.23.1",
    "typescript": "^7.0.2",
    "vite": "^8.0.0",
    "vitest": "^5.0.4"
  },
  "packageManager": "pnpm@10.15.0"
}
